# Core database
# Neon PostgreSQL connection string. Never commit the real value.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Public application URL
NEXT_PUBLIC_APP_URL=https://floushlogistics.com

# Zoho Mail SMTP
# Use a Zoho app password in Railway, never your normal mailbox password.
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_SECURE=true
ZOHO_SMTP_USER=floushlogistics@floushlogistics.com
ZOHO_SMTP_PASSWORD=replace_with_zoho_app_password

# Sender and internal notification destination.
# If quotes@ is configured as a Zoho send-as alias, use it here.
ZOHO_SMTP_FROM=Floush Logistics <floushlogistics@floushlogistics.com>
QUOTE_NOTIFICATION_EMAIL=operations@floushlogistics.com
