# Quote request email delivery
# Create a Resend API key and add these values to your deployment environment.
RESEND_API_KEY=re_xxxxxxxxx
QUOTE_NOTIFICATION_EMAIL=operations@floushfreight.com

# For local testing before floushfreight.com is verified with your email provider:
QUOTE_FROM_EMAIL=Floush Logistics <onboarding@resend.dev>

# After floushfreight.com is verified, switch to a branded sender such as:
# QUOTE_FROM_EMAIL=Floush Logistics <quotes@floushfreight.com>
