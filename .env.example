# Core database
# Neon PostgreSQL connection string. Never commit the real value.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Public application URL
NEXT_PUBLIC_APP_URL=https://floushlogistics.com

# Zoho Mail SMTP
# Use a Zoho app password in Railway, never your normal mailbox password.
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_SECURE=true
ZOHO_SMTP_USER=floushlogistics@floushlogistics.com
ZOHO_SMTP_PASSWORD=replace_with_zoho_app_password

# quotes@floushlogistics.com is a Zoho alias on the primary Floush mailbox.
ZOHO_SMTP_FROM=Floush Quotes <quotes@floushlogistics.com>
QUOTE_NOTIFICATION_EMAIL=quotes@floushlogistics.com
